{
  "name": "backups",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @backups/server & npm run dev --workspace @backups/web & wait",
    "dev:server": "npm run dev --workspace @backups/server",
    "dev:web": "npm run dev --workspace @backups/web",
    "build": "npm run build --workspace @backups/web && npm run build --workspace @backups/server",
    "start": "npm run start --workspace @backups/server",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @backups/server",
    "db:generate": "npm run db:generate --workspace @backups/server",
    "db:migrate": "npm run db:migrate --workspace @backups/server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sentry": "0.49.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
